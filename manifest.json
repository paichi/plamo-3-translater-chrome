{
  "manifest_version": 3,
  "name": "PLaMo 翻訳",
  "description": "PLaMo 翻訳モデルで、ページ全体や選択した文章をその場で翻訳します。",
  "version": "0.6.1",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus", "scripting", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/markup.js",
        "src/content/page-translator.js",
        "src/content/selection-popup.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PLaMo 翻訳",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "ページを翻訳する／原文に戻す"
    },
    "translate-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "選択した文章を翻訳する"
    }
  }
}
